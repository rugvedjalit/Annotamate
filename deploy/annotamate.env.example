# Annotamate configuration for the systemd unit (deploy/annotamate.service).
#
#   sudo install -d -m 0750 -o root -g annotamate /etc/annotamate
#   sudo install -m 0640 -o root -g annotamate deploy/annotamate.env.example /etc/annotamate/annotamate.env
#
# Syntax: KEY=value, one per line, no `export`, no quotes needed.
# Command-line flags take precedence over these variables.

# Address and port to listen on. Keep 127.0.0.1 when a reverse proxy on this
# machine terminates HTTPS (recommended). Use 0.0.0.0 to serve a trusted LAN directly.
ANNOTAMATE_HOST=127.0.0.1
ANNOTAMATE_PORT=8765

# Folders in which projects may be created, separated by ":" (";" on Windows).
# Every project folder must be inside one of them. The service user needs
# read and write access. Also list them in ReadWritePaths= in the unit file.
ANNOTAMATE_ROOTS=/data/datasets

# Application state: SQLite database and caches (thumbnails, re-encoded images).
ANNOTAMATE_DATA_DIR=/var/lib/annotamate

# Mark the session cookie "Secure". Set to true whenever users reach
# Annotamate over HTTPS; leave false for plain HTTP (an SSH tunnel or a LAN),
# otherwise browsers will not send the cookie and nobody can sign in.
ANNOTAMATE_SECURE_COOKIES=false

# Path prefix when hosted under a sub-path, e.g. https://example.com/annotamate/
# The reverse proxy must forward the path unchanged (no prefix stripping).
#ANNOTAMATE_BASE_URL=/annotamate/

# Database. Default: sqlite:///<data dir>/annotamate.db
# PostgreSQL needs the extra: pip install "annotamate[postgres]"
#ANNOTAMATE_DATABASE_URL=postgresql+psycopg://annotamate:change-me@127.0.0.1:5432/annotamate

# Days a session stays valid without activity.
#ANNOTAMATE_SESSION_DAYS=14

# Days after sign-in at which a session ends however often it is used.
#ANNOTAMATE_SESSION_MAX_DAYS=90

# Largest accepted upload, per file, in megabytes.
#ANNOTAMATE_MAX_UPLOAD_MB=50

# Largest whole upload request (all files together), in megabytes. A reverse
# proxy must allow at least this much on the upload path.
#ANNOTAMATE_MAX_UPLOAD_REQUEST_MB=1024

# Largest request body for everything except uploads (JSON, forms), in megabytes.
#ANNOTAMATE_MAX_BODY_MB=2

# Images with more pixels than this are refused (decompression-bomb protection).
#ANNOTAMATE_MAX_IMAGE_MEGAPIXELS=150

# Threads that answer requests (1-64). Leave it at 4: more threads make a busy
# server slower, because Python runs one at a time. Image decoding, uploads,
# indexing and class changes have their own threads.
#ANNOTAMATE_WORKER_THREADS=4

# Failed sign-ins allowed per client address in 10 minutes, across all user names
# (0 = no limit). IPv6 counts per /64; loopback and private addresses get ten times
# as many, because many users can share one of them.
#ANNOTAMATE_LOGIN_IP_LIMIT=30

# critical, error, warning, info or debug
#ANNOTAMATE_LOG_LEVEL=info

# Reverse proxy on another machine: the addresses (comma-separated) whose
# X-Forwarded-For header is trusted, so that the sign-in rate limit sees real
# client addresses. The default, 127.0.0.1, already covers a proxy on this machine.
# Read by uvicorn, not by Annotamate itself.
#FORWARDED_ALLOW_IPS=10.0.0.5
